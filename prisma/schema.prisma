generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Os dois sócios. Mesmo acesso para ambos; o que muda é o registro de autoria.
model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String?
  criadoEm  DateTime @default(now())

  // Proteção contra tentativa de senha por força bruta (ver src/lib/usuario.ts)
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?

  // Convite de primeiro acesso: só o sha256 do token fica no banco; o token
  // vai no link gerado em /convites. Uso único, com validade.
  conviteHash     String?   @unique
  conviteExpiraEm DateTime?

  lancamentosCriados    Lancamento[]         @relation("criadoPor")
  lancamentosAlterados  Lancamento[]         @relation("atualizadoPor")
  registrosDeAuditoria  RegistroAuditoria[]
  tarefasConcluidas     TarefaCronograma[]
}

// Plano de contas. `categoria` e `atividade` usam os mesmos textos da planilha
// (ver src/lib/contabil/tipos.ts — CATEGORIAS e ATIVIDADES), que definem em que
// linha da DRE ou do Balanço a conta cai.
model Conta {
  id        String   @id @default(cuid())
  nome      String   @unique
  categoria String
  atividade String
  natureza  String // "D" (devedora) ou "C" (credora)
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  apelidos ContaApelido[]
  partidas Partida[]
}

// Grafias antigas com que a conta aparece na planilha ("cc acm", "CC ACM"…),
// usadas para mapear a importação e, depois, a leitura de boletos.
model ContaApelido {
  id      String @id @default(cuid())
  nome    String @unique
  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)
}

// Um lançamento em partidas dobradas: a soma de `partidas.valorCentavos` é zero.
model Lancamento {
  id        String   @id @default(cuid())
  data      DateTime @db.Date
  historico String?
  origem    String // "PLANILHA" | "MANUAL" | "BOLETO"

  // Rastro da linha de origem na planilha Gerencial Financeiro (origem = PLANILHA)
  linhaPlanilhaInicio Int?
  linhaPlanilhaFim    Int?

  criadoPorId     String?
  criadoPor       Usuario? @relation("criadoPor", fields: [criadoPorId], references: [id])
  criadoEm        DateTime @default(now())
  atualizadoPorId String?
  atualizadoPor   Usuario? @relation("atualizadoPor", fields: [atualizadoPorId], references: [id])
  atualizadoEm    DateTime @updatedAt

  partidas Partida[]

  @@index([data])
  @@index([origem])
}

// Uma perna do lançamento. Valor positivo = débito, negativo = crédito.
// A data fica na partida porque a planilha tem lançamentos cujas pernas caem
// em datas (e até anos) diferentes; os relatórios usam a data da partida.
model Partida {
  id                   String     @id @default(cuid())
  lancamentoId         String
  lancamento           Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  contaId              String
  conta                Conta      @relation(fields: [contaId], references: [id])
  data                 DateTime   @db.Date
  valorCentavos        Int
  historico            String?
  fiscal               Boolean? // coluna "Fiscal S/N" da planilha
  valorNominalCentavos Int?
  linhaPlanilha        Int?

  @@index([data])
  @@index([contaId])
  @@index([lancamentoId])
}

// Cotações de mercado, uma por produto por dia. As automáticas vêm do cron
// diário (src/app/api/cron/cotacoes); o maracujá é registrado à mão no painel.
model Cotacao {
  id           String   @id @default(cuid())
  produto      String // chave de PRODUTOS em src/lib/cotacoes/produtos.ts
  data         DateTime @db.Date
  valor        Float
  origem       String // "AUTOMATICA" | "MANUAL"
  criadoPorId  String?
  atualizadoEm DateTime @updatedAt

  @@unique([produto, data])
  @@index([produto, data])
}

// Cronograma de produção: tarefas por atividade e ano, com checklist.
// Cada ano nasce de um modelo (src/lib/cronograma/modelos.ts) e é editável.
model TarefaCronograma {
  id             String    @id @default(cuid())
  atividade      String // "CAFE" | "MARACUJA" | "MILHO" | "PECUARIA"
  ano            Int
  etapa          String
  titulo         String
  mesInicio      Int // 1–12
  mesFim         Int // 1–12, >= mesInicio
  ordem          Int
  concluida      Boolean   @default(false)
  concluidaEm    DateTime?
  concluidaPorId String?
  concluidaPor   Usuario?  @relation(fields: [concluidaPorId], references: [id])
  criadoEm       DateTime  @default(now())

  @@index([atividade, ano])
}

// Quem fez o quê: toda criação, alteração e exclusão de lançamento ou conta.
model RegistroAuditoria {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  entidade   String // "Lancamento" | "Conta" | ...
  entidadeId String
  acao       String // "CRIAR" | "ALTERAR" | "EXCLUIR" | "IMPORTAR"
  antes      Json?
  depois     Json?
  em         DateTime @default(now())

  @@index([entidade, entidadeId])
}
