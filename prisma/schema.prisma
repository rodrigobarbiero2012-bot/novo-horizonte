generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Os dois sócios. Mesmo acesso para ambos; o que muda é o registro de autoria.
model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String?
  criadoEm  DateTime @default(now())

  // Proteção contra tentativa de senha por força bruta (ver src/lib/usuario.ts)
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?

  // Convite de primeiro acesso: só o sha256 do token fica no banco; o token
  // vai no link gerado em /convites. Uso único, com validade.
  conviteHash     String?   @unique
  conviteExpiraEm DateTime?

  lancamentosCriados   Lancamento[]        @relation("criadoPor")
  lancamentosAlterados Lancamento[]        @relation("atualizadoPor")
  registrosDeAuditoria RegistroAuditoria[]
  tarefasConcluidas    TarefaCronograma[]
}

// Plano de contas. `categoria` e `atividade` usam os mesmos textos da planilha
// (ver src/lib/contabil/tipos.ts — CATEGORIAS e ATIVIDADES), que definem em que
// linha da DRE ou do Balanço a conta cai.
model Conta {
  id        String   @id @default(cuid())
  nome      String   @unique
  categoria String
  atividade String
  natureza  String // "D" (devedora) ou "C" (credora)
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  apelidos ContaApelido[]
  partidas Partida[]
  titulos  Titulo[]            @relation("contaDoTitulo")
  baixas   Titulo[]            @relation("contaDaBaixa")
  extratos ImportacaoExtrato[] @relation("contaDoExtrato")
}

// Grafias antigas com que a conta aparece na planilha ("cc acm", "CC ACM"…),
// usadas para mapear a importação e, depois, a leitura de boletos.
model ContaApelido {
  id      String @id @default(cuid())
  nome    String @unique
  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)
}

// Um lançamento em partidas dobradas: a soma de `partidas.valorCentavos` é zero.
model Lancamento {
  id        String   @id @default(cuid())
  data      DateTime @db.Date
  historico String?
  origem    String // "PLANILHA" | "MANUAL" | "DOCUMENTO" | "TITULO" | "EXTRATO"

  // Rastro da linha de origem na planilha Gerencial Financeiro (origem = PLANILHA)
  linhaPlanilhaInicio Int?
  linhaPlanilhaFim    Int?

  criadoPorId     String?
  criadoPor       Usuario? @relation("criadoPor", fields: [criadoPorId], references: [id])
  criadoEm        DateTime @default(now())
  atualizadoPorId String?
  atualizadoPor   Usuario? @relation("atualizadoPor", fields: [atualizadoPorId], references: [id])
  atualizadoEm    DateTime @updatedAt

  partidas Partida[]
  titulo   Titulo?

  @@index([data])
  @@index([origem])
}

// Uma perna do lançamento. Valor positivo = débito, negativo = crédito.
// A data fica na partida porque a planilha tem lançamentos cujas pernas caem
// em datas (e até anos) diferentes; os relatórios usam a data da partida.
model Partida {
  id                   String             @id @default(cuid())
  lancamentoId         String
  lancamento           Lancamento         @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  contaId              String
  conta                Conta              @relation(fields: [contaId], references: [id])
  data                 DateTime           @db.Date
  valorCentavos        Int
  historico            String?
  fiscal               Boolean? // coluna "Fiscal S/N" da planilha
  valorNominalCentavos Int?
  linhaPlanilha        Int?
  transacaoBancaria    TransacaoBancaria?

  @@index([data])
  @@index([contaId])
  @@index([lancamentoId])
}

// Cotações de mercado, uma por produto por dia. As automáticas vêm do cron
// diário (src/app/api/cron/cotacoes); o maracujá é registrado à mão no painel.
model Cotacao {
  id           String   @id @default(cuid())
  produto      String // chave de PRODUTOS em src/lib/cotacoes/produtos.ts
  data         DateTime @db.Date
  valor        Float
  origem       String // "AUTOMATICA" | "MANUAL"
  criadoPorId  String?
  atualizadoEm DateTime @updatedAt

  @@unique([produto, data])
  @@index([produto, data])
}

// Contas a pagar e a receber. A baixa (pagamento/recebimento) gera um
// Lancamento: débito/crédito na conta do título contra a conta de pagamento.
model Titulo {
  id                 String      @id @default(cuid())
  tipo               String // "PAGAR" | "RECEBER"
  descricao          String
  contraparte        String? // fornecedor (pagar) ou cliente (receber)
  valorCentavos      Int // sempre positivo
  vencimento         DateTime    @db.Date
  contaId            String // despesa/custeio/ativo/passivo (pagar) ou receita (receber)
  conta              Conta       @relation("contaDoTitulo", fields: [contaId], references: [id])
  numeroDocumento    String?
  linhaDigitavel     String?
  grupoParcelasId    String? // mesmo valor em todas as parcelas de um parcelamento
  parcela            Int?
  totalParcelas      Int?
  status             String      @default("ABERTO") // "ABERTO" | "BAIXADO" | "CANCELADO"
  baixadoEm          DateTime?   @db.Date
  valorBaixaCentavos Int?
  contaBaixaId       String?
  contaBaixa         Conta?      @relation("contaDaBaixa", fields: [contaBaixaId], references: [id])
  lancamentoId       String?     @unique
  lancamento         Lancamento? @relation(fields: [lancamentoId], references: [id])
  origem             String      @default("MANUAL") // "MANUAL" | "DOCUMENTO"
  criadoPorId        String?
  criadoEm           DateTime    @default(now())

  @@index([status, vencimento])
  @@index([grupoParcelasId])
}

// Conciliação bancária: extratos OFX importados por conta (banco ou CC do
// sócio) e cada transação, conciliada com uma partida do razão, lançada ou ignorada.
model ImportacaoExtrato {
  id                 String    @id @default(cuid())
  contaId            String
  conta              Conta     @relation("contaDoExtrato", fields: [contaId], references: [id])
  arquivo            String
  banco              String?
  inicio             DateTime? @db.Date
  fim                DateTime? @db.Date
  saldoFinalCentavos Int?
  dataSaldo          DateTime? @db.Date
  novas              Int
  repetidas          Int
  criadoPorId        String?
  criadoEm           DateTime  @default(now())

  transacoes TransacaoBancaria[]
}

model TransacaoBancaria {
  id            String            @id @default(cuid())
  importacaoId  String
  importacao    ImportacaoExtrato @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  contaId       String
  fitid         String
  data          DateTime          @db.Date
  valorCentavos Int // positivo = entrou na conta
  descricao     String
  status        String            @default("PENDENTE") // "PENDENTE" | "CONCILIADA" | "IGNORADA"
  partidaId     String?           @unique
  partida       Partida?          @relation(fields: [partidaId], references: [id], onDelete: SetNull)
  criadoEm      DateTime          @default(now())

  @@unique([contaId, fitid])
  @@index([contaId, status, data])
}

// Produção: talhões (ou pastos) e movimentos físicos — colheita, venda,
// consumo, perda, ajuste; no gado, compra/nascimento/venda/morte em cabeças.
// A unidade de cada atividade é fixa (src/lib/producao/atividades.ts).
model Talhao {
  id         String   @id @default(cuid())
  atividade  String // "CAFE" | "MARACUJA" | "MILHO" | "PECUARIA"
  nome       String
  areaHa     Float
  variedade  String?
  anoPlantio Int?
  plantas    Int?
  ativo      Boolean  @default(true)
  observacao String?
  criadoEm   DateTime @default(now())

  movimentos MovimentoProducao[]

  @@index([atividade])
}

model MovimentoProducao {
  id            String   @id @default(cuid())
  atividade     String
  data          DateTime @db.Date
  tipo          String // ver TIPOS_MOVIMENTO
  quantidade    Float // sempre positiva; o tipo define se entra ou sai (AJUSTE pode ser negativo)
  talhaoId      String?
  talhao        Talhao?  @relation(fields: [talhaoId], references: [id], onDelete: SetNull)
  valorCentavos Int? // valor da venda/compra, quando houver
  observacao    String?
  criadoPorId   String?
  criadoEm      DateTime @default(now())

  @@index([atividade, data])
}

// Cronograma de produção: tarefas por atividade e ano, com checklist.
// Cada ano nasce de um modelo (src/lib/cronograma/modelos.ts) e é editável.
model TarefaCronograma {
  id             String    @id @default(cuid())
  atividade      String // "CAFE" | "MARACUJA" | "MILHO" | "PECUARIA"
  ano            Int
  etapa          String
  titulo         String
  mesInicio      Int // 1–12
  mesFim         Int // 1–12, >= mesInicio
  ordem          Int
  concluida      Boolean   @default(false)
  concluidaEm    DateTime?
  concluidaPorId String?
  concluidaPor   Usuario?  @relation(fields: [concluidaPorId], references: [id])
  criadoEm       DateTime  @default(now())

  @@index([atividade, ano])
}

// Quem fez o quê: toda criação, alteração e exclusão de lançamento ou conta.
model RegistroAuditoria {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  entidade   String // "Lancamento" | "Conta" | ...
  entidadeId String
  acao       String // "CRIAR" | "ALTERAR" | "EXCLUIR" | "IMPORTAR"
  antes      Json?
  depois     Json?
  em         DateTime @default(now())

  @@index([entidade, entidadeId])
}
